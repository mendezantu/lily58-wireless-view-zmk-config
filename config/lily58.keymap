#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   `   |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   -   |
            // |  CTRL |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |   "["  |  |  "]"  |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //                     | ALT  | GUI  | LOWER|  SPACE |  | ENTER | RAISE| BSPC  | GUI   |

            display-name = "Base";
            bindings = <
&kp ESC         &kp N1  &kp N2  &kp N3            &kp N4              &kp N5                                              &kp N6       &kp N7               &kp N8             &kp N9   &kp N0            &kp EQUAL
&lt 2 TAB       &kp Q   &kp W   &kp E             &kp R               &kp T                                               &kp Y        &kp U                &kp I              &kp O    &kp P             &lt 2 MINUS
&lt 1 ENTER     &kp A   &kp S   &kp D             &kp F               &kp G                                               &kp H        &kp J                &kp K              &kp L    &kp SINGLE_QUOTE  &lt 1 ENTER
&kp LEFT_SHIFT  &kp Z   &kp X   &kp C             &kp V               &kp B                   &kp ENTER      &kp ENTER    &kp N        &kp M                &kp COMMA          &kp DOT  &kp FSLH          &kp RSHFT
                                &kp LEFT_CONTROL  &mt LEFT_ALT ENTER  &mt LEFT_WIN BACKSPACE  &lt 1 SPACE    &lt 1 SPACE  &lt 1 SPACE  &mt RMETA BACKSPACE  &kp RIGHT_CONTROL
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        lower_layer {
            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR | BT1 | BT2 |  BT3 |  BT4 |  BT5 |                   |      |       |       |      |       |       |
            // |  F1   |  F2 |  F3 |  F4  |  F5  |  F6  |                   |  F7  |  F8   |  F9   |  F10 |  F11  |  F12  |
            // |   `   |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   ~   |
            // |       |     |     |      |      |      |        |  |       |      |  _    |  +    |  {   |   }   |  "|"  |
            //                     |      |      |      |        |  |       |      |       |       |

            display-name = "Lower";
            bindings = <
&kp TILDE            &none             &none              &none                    &none             &kp HOME                                      &kp HOME           &kp K_PREV         &kp K_NEXT                &none            &kp K_MUTE        &kp K_VOLUME_UP
&kp GRAVE            &none             &none              &kp UP_ARROW             &none             &kp PG_UP                                     &kp PAGE_UP        &none              &kp UP_ARROW              &none            &kp K_PLAY_PAUSE  &kp K_VOLUME_DOWN
&none                &none             &kp LEFT_ARROW     &kp DOWN_ARROW           &kp RIGHT_ARROW   &kp PAGE_DOWN                                 &kp PAGE_DOWN      &kp LEFT_ARROW     &kp DOWN_ARROW            &kp RIGHT_ARROW  &none             &none
&mt LEFT_SHIFT CAPS  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp LEFT_BRACE           &kp RIGHT_BRACE   &kp END           &kp K_PASTE    &kp K_PASTE  &kp END            &kp PIPE           &kp SEMICOLON             &kp COLON        &kp BACKSLASH     &mt RIGHT_SHIFT CAPS
                                                          &mt LEFT_CONTROL ESCAPE  &mt LEFT_ALT TAB  &mt LEFT_WIN DEL  &none          &none        &mt RIGHT_WIN DEL  &mt RIGHT_ALT TAB  &mt RIGHT_CONTROL ESCAPE
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        raise_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |       |     |     |      |      |      |                   |      |       |       |      |       |       |
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |   7   |   8   |  9   |   0   |       |
            // |   F1  |  F2 |  F3 |  F4  |  F5  |  F6  |                   |      |   <-  |   v   |  ^   |  ->   |       |
            // |   F7  |  F8 |  F9 |  F10 |  F11 |  F12 |        |  |       |  +   |   -   |   =   |  [   |   ]   |   \   |
            //                     |      |      |      |        |  |       |      |       |       |

            display-name = "Raise";
            bindings = <
&none           &kp F1   &kp F2   &kp F3            &kp F4          &kp F5                                       &none          &kp KP_NUMBER_7  &kp KP_NUMBER_8    &kp KP_NUMBER_9  &kp KP_PLUS   &none
&none           &kp F6   &kp F7   &kp F8            &kp F9          &kp F10                                      &none          &kp KP_NUMBER_4  &kp KP_NUMBER_5    &kp KP_NUMBER_6  &kp KP_MINUS  &none
&none           &kp F11  &kp F12  &none             &none           &none                                        &none          &kp KP_NUMBER_1  &kp KP_NUMBER_2    &kp KP_NUMBER_3  &kp ASTERISK  &none
&kp LEFT_SHIFT  &none    &none    &none             &studio_unlock  &kp PRINTSCREEN  &kp K_PASTE    &kp K_PASTE  &none          &none            &kp KP_NUMBER_0    &kp KP_DOT       &kp SLASH     &kp RIGHT_SHIFT
                                  &kp LEFT_CONTROL  &kp LEFT_ALT    &kp LEFT_WIN     &none          &none        &kp RIGHT_WIN  &kp RIGHT_ALT    &kp RIGHT_CONTROL
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        extra_1 { status = "reserved"; };

        extra_2 { status = "reserved"; };

        extra_3 { status = "reserved"; };
    };
};
